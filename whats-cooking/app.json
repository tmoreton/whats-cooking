{
  "expo": {
    "name": "What's Cooking?",
    "slug": "whats-cooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "whatscooking",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tmoreton.whatscooking",
      "infoPlist": {
        "NSCameraUsageDescription": "What's Cooking? needs access to your camera so you can snap a photo of your fridge and get recipe suggestions."
      }
    },
    "android": {
      "package": "com.tmoreton.whatscooking",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "What's Cooking? needs access to your camera so you can snap a photo of your fridge and get recipe suggestions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
