# Backend connection for the "What's Cooking?" iOS app.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time.
# NONE of these are secrets — the Identity Pool id is designed to be public.
# The app authenticates as an anonymous Cognito "guest" (short-lived AWS creds)
# and SigV4-signs requests to the AWS_IAM-protected API. No secret is bundled.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:253170388727:runtime/whats_cooking-iik9UNDwCW

# HTTP endpoint the app POSTs { images, preferences, mode } to (AWS_IAM auth).
EXPO_PUBLIC_API_URL=https://odrc67iamk.execute-api.us-east-1.amazonaws.com/invocations

# Cognito Identity Pool for anonymous guest credentials (public id).
EXPO_PUBLIC_IDENTITY_POOL_ID=us-east-1:81e079d5-c258-45d3-ae1f-bc0130860121
