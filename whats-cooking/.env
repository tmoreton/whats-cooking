# Backend connection for the "What's Cooking?" iOS app.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time.
# NONE of these are secrets. The app signs the user in against a Cognito User
# Pool and sends their ID token as `Authorization: Bearer <token>`; the API's
# JWT authorizer validates it. No secret is bundled.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:253170388727:runtime/whats_cooking-iik9UNDwCW

# HTTP endpoint the app POSTs { images, preferences, mode } to. NEW builds use
# the JWT-protected /v1/invocations route (Authorization: Bearer <ID token>).
# Already-shipped builds still hit /invocations (AWS_IAM guest creds) — see the
# proxy stack's LegacyApiUrl output.
EXPO_PUBLIC_API_URL=https://odrc67iamk.execute-api.us-east-1.amazonaws.com/v1/invocations

# Cognito User Pool (email + password sign-in). Values from the proxy stack
# outputs (aws cloudformation describe-stacks --stack-name whats-cooking-proxy).
EXPO_PUBLIC_USER_POOL_ID=us-east-1_RzbyEqpaz
EXPO_PUBLIC_USER_POOL_CLIENT_ID=3on5pv8rei9ge4dugnobqkec1u
