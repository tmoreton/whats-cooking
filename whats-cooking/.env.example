# Copy to `.env` and fill in values from the proxy stack outputs
# (`aws cloudformation describe-stacks --stack-name whats-cooking-proxy`).
# EXPO_PUBLIC_* vars are inlined into the client bundle. None are secrets.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<name>-<id>

# New builds use the JWT-protected /v1/invocations route (Authorization: Bearer
# <ID token>). See the proxy stack's ApiUrl output.
EXPO_PUBLIC_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1/invocations

# Cognito User Pool the app authenticates against (email + password). The app
# sends the ID token as `Authorization: Bearer <token>`; the API's JWT
# authorizer validates it. The client id is a public value (no secret).
EXPO_PUBLIC_USER_POOL_ID=<region>_<pool-id>
EXPO_PUBLIC_USER_POOL_CLIENT_ID=<app-client-id>
