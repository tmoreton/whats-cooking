# Copy to `.env` and fill in values from the proxy stack outputs
# (`aws cloudformation describe-stacks --stack-name whats-cooking-proxy`) and the
# client secret (`aws cognito-idp describe-user-pool-client ...`).
# EXPO_PUBLIC_* vars are inlined into the client bundle.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<name>-<id>

EXPO_PUBLIC_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/invocations

EXPO_PUBLIC_COGNITO_TOKEN_URL=https://<domain-prefix>.auth.<region>.amazoncognito.com/oauth2/token
EXPO_PUBLIC_COGNITO_CLIENT_ID=<user-pool-client-id>
EXPO_PUBLIC_COGNITO_CLIENT_SECRET=<user-pool-client-secret>
EXPO_PUBLIC_COGNITO_SCOPE=whatscooking/invoke
