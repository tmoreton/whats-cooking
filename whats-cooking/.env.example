# Copy to `.env` and fill in your values.
# EXPO_PUBLIC_* vars are inlined into the client bundle — do NOT put secrets here.

# AWS region the AgentCore runtime is deployed in.
EXPO_PUBLIC_AWS_REGION=us-east-1

# Deployed AgentCore runtime ARN (from `agentcore status`).
EXPO_PUBLIC_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<name>-<id>

# HTTP endpoint the app POSTs { image, preferences, mode } to — a proxy that
# SigV4-signs to the runtime above. Leave unset to use local dev on :8080.
# EXPO_PUBLIC_API_URL=https://<your-proxy-endpoint>/invocations
